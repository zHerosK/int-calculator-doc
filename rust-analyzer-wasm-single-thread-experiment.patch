-    } else if let Some(line) = line.strip_prefix("pub(in ") {
-        panic!("pub in not supported: {}", line);
+    } else if line.starts_with("pub(in ") {
+        // Preserve restricted visibility when flattening the newer standard-library
+        // source used to generate fake_std.rs / fake_core.rs / fake_alloc.rs.
+        let marker = " mod ";
+        let index = line.find(marker)?;
+        Some(Mod {
+            explicit_path: current_mod_state.path_seen,
+            pub_prefix: &line[..index + 1],
+            name: clean_token(&line[index + marker.len()..]),
+        })
     } else {
