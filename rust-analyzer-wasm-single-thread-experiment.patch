@@ -38,5 +38,9 @@
 fn is_external_mod<'a>(mod_state: &mut ModState<'a>, line: &'a str) -> Option<Mod<'a>> {
     let line = remove_comment(line);
     if line.is_empty() {
         return None;
     }
+    // Test modules are not part of the analysis environment; do not expand them.
+    if line == "mod tests;" || line == "pub mod tests;" {
+        return None;
+    }
@@ -91,8 +91,16 @@
             pub_prefix: "pub(super) ",
